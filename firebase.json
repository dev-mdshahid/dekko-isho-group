{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sustainibility-report-2025",
        "destination": "/documents/Impact Journal 2025.pdf"
      },
      {
        "source": "/sustainability-report-2025",
        "destination": "/documents/Impact Journal 2025.pdf"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
