# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8794
# Production binds to 127.0.0.1 behind Caddy
HOST=127.0.0.1
LOG_LEVEL=info

# ── URLs ─────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://dekko-isho-group.web.app
HR_PORTAL_URL=https://dekko-isho-group.web.app/hr/admin
API_PUBLIC_URL=https://hr.dekkoai.online
CORS_ORIGINS=https://dekko-isho-group.web.app,https://dekko-isho-group.firebaseapp.com

# ── Firebase (Firestore + Auth via Admin SDK) ────────────────────────────────
FIREBASE_PROJECT_ID=dekko-isho-group
GOOGLE_APPLICATION_CREDENTIALS=/root/secrets/dekko-isho-group-firebase-sa.json
# Local development instead:
# FIREBASE_PROJECT_ID=demo-dekko-isho
# FIRESTORE_EMULATOR_HOST=localhost:8085
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── File storage ─────────────────────────────────────────────────────────────
# b2 in production, local (./.storage) for development
STORAGE_DRIVER=b2
# Scoped key from `npm run b2:setup` (restricted to hr-main-website/)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=Dekko-Document-Management-System
B2_PREFIX=hr-main-website/
# Random 32+ byte secret (openssl rand -hex 32)
FILE_SIGNING_SECRET=

# ── CV reading (OpenAI) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CV_MODEL=gpt-4o-mini
OPENAI_CV_VISION_MODEL=gpt-4o
CV_PARSE_CONCURRENCY=2

# ── Spam protection (Cloudflare Turnstile, optional) ─────────────────────────
TURNSTILE_SECRET=

# ── Email (Gmail App Password, not the account password) ─────────────────────
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=Dekko Isho Group Careers
# Optional: where applicant replies go (defaults to MAIL_USER)
MAIL_REPLY_TO=
MAIL_DISABLED=false
# Website contact form messages go here
CONTACT_INBOX=connect@dekkoisho.com

# ── Scheduled tasks ──────────────────────────────────────────────────────────
CRON_ENABLED=true
TZ_DISPLAY=Asia/Dhaka
